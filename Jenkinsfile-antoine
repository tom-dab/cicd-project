pipeline {
    agent {
        docker {
            image 'python:3.11-slim'
            args '-u root'
        }
    }
    
    environment {
        PYTHONPATH = "${WORKSPACE}/backend"
        BUILD_VERSION = "1.0.${env.BUILD_NUMBER}"
        ARTIFACT_PREFIX = "cicd-project-${env.BUILD_VERSION}"
        DEPLOY_SERVER = credentials('deploy-server-ip')
        DEPLOY_USER = 'deploy'
    }
    
    stages {
        stage('🔍 Checkout & Info') {
            steps {
                echo "🚀 Démarrage pipeline ${env.BUILD_VERSION}"
                sh '''
                    echo "✅ Code source récupéré"
                    ls -la
                    echo "🐍 Fichiers Python:"
                    find . -name "*.py" -type f
                '''
            }
        }
        
        stage('🔧 Setup Environment') {
            steps {
                echo '🔧 Configuration environnement'
                sh '''
                    pip install --upgrade pip
                    apt-get update && apt-get install -y zip unzip openssh-client sshpass
                    
                    if [ -f "requirements.txt" ]; then
                        pip install -r requirements.txt
                    else
                        pip install flask flask-cors requests
                    fi
                    
                    pip install pytest pytest-html pytest-cov
                    echo "✅ Environnement prêt"
                '''
            }
        }
        
        stage('🧪 Run Tests') {
            steps {
                echo '🧪 Exécution des tests'
                sh '''
                    export PYTHONPATH="${WORKSPACE}/backend"
                    
                    pytest -v \\
                        --junitxml=test-results.xml \\
                        --html=test-report.html \\
                        --self-contained-html \\
                        backend/ || TEST_EXIT_CODE=$?
                    
                    if [ "${TEST_EXIT_CODE:-0}" -ne 0 ]; then
                        echo "❌ Tests échoués - arrêt du build"
                        exit ${TEST_EXIT_CODE}
                    else
                        echo "✅ Tests réussis - déploiement autorisé"
                    fi
                '''
            }
            
            post {
                always {
                    junit 'test-results.xml'
                    archiveArtifacts artifacts: 'test-report.html', allowEmptyArchive: true
                }
            }
        }
        
        stage('📦 Build Frontend') {
            when {
                expression { currentBuild.result != 'FAILURE' }
            }
            steps {
                echo '🎨 Build Frontend'
                sh '''
                    mkdir -p dist/frontend
                    
                    if [ -d "frontend" ]; then
                        cp -r frontend/* dist/frontend/
                        echo "✅ Frontend copié"
                    else
                        cat > dist/frontend/index.html << 'FEOF'
<!DOCTYPE html>
<html>
<head>
    <title>CICD Project - Version ${BUILD_VERSION}</title>
    <style>
        body { font-family: Arial; margin: 50px; text-align: center; }
        .version { color: #666; font-size: 14px; }
        .status { color: green; font-weight: bold; }
    </style>
</head>
<body>
    <h1>🚀 CICD Project</h1>
    <p class="status">✅ Déployé automatiquement par Jenkins!</p>
    <p class="version">Version: ${BUILD_VERSION}</p>
    <p class="version">Déployé le: $(date)</p>
    <hr>
    <p><a href="/api/employe">🔗 Tester l'API Backend</a></p>
</body>
</html>
FEOF
                        echo "✅ Frontend demo créé"
                    fi
                    
                    echo "Build: ${BUILD_VERSION}" > dist/frontend/version.txt
                    echo "Date: $(date)" >> dist/frontend/version.txt
                    
                    cd dist
                    zip -r "${ARTIFACT_PREFIX}-frontend.zip" frontend/
                    cd ..
                    
                    echo "✅ Frontend packagé"
                '''
            }
        }
        
        stage('🐍 Build Backend') {
            when {
                expression { currentBuild.result != 'FAILURE' }
            }
            steps {
                echo '⚙️ Build Backend'
                sh '''
                    mkdir -p dist/backend
                    
                    if [ -d "backend" ]; then
                        echo "📂 Copie des fichiers backend"
                        for file in backend/*.py; do
                            if [[ "$file" != *test* ]]; then
                                cp "$file" dist/backend/
                                echo "Copié: $(basename "$file")"
                            fi
                        done
                        
                        [ -f "requirements.txt" ] && cp requirements.txt dist/backend/
                        
                        echo "📝 Création version.py"
                        cat > dist/backend/version.py << 'VEOF'
BUILD_VERSION = "${BUILD_VERSION}"
BUILD_DATE = "$(date)"
BUILD_NUMBER = "${BUILD_NUMBER}"

def get_version_info():
    return {
        "version": BUILD_VERSION,
        "build_date": BUILD_DATE,
        "build_number": BUILD_NUMBER
    }
VEOF
                        
                        echo "📝 Création app_deploy.py"
                        cat > dist/backend/app_deploy.py << 'SEOF'
#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

try:
    from app import app
    from version import get_version_info
    
    print(f"🚀 Démarrage backend - Version: {get_version_info()['version']}")
    
    # Configuration pour production
    app.config['DEBUG'] = False
    app.config['TESTING'] = False
    
    if __name__ == '__main__':
        app.run(host='0.0.0.0', port=5000, debug=False)
    
except ImportError as e:
    print(f"❌ Erreur import: {e}")
    sys.exit(1)
except Exception as e:
    print(f"❌ Erreur: {e}")
    sys.exit(1)
SEOF
                        
                        # Service systemd pour le backend
                        cat > dist/backend/backend-app.service << 'SERVEOF'
[Unit]
Description=Backend CICD Application
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/backend-app
ExecStart=/usr/bin/python3 /opt/backend-app/app_deploy.py
Restart=always
RestartSec=3
Environment=PYTHONPATH=/opt/backend-app

[Install]
WantedBy=multi-user.target
SERVEOF
                        
                        cd dist
                        zip -r "${ARTIFACT_PREFIX}-backend.zip" backend/
                        cd ..
                        
                        echo "✅ Backend packagé"
                        ls -la dist/backend/
                        
                    else
                        echo "❌ Dossier backend introuvable"
                        exit 1
                    fi
                '''
            }
        }
        
        stage('🚀 Deploy Frontend') {
            when {
                expression { currentBuild.result != 'FAILURE' }
            }
            steps {
                echo '🌐 Déploiement Frontend sur Apache'
                sshagent(['deploy-ssh-key']) {
                    sh '''
                        echo "📤 Envoi frontend vers serveur"
                        
                        # Copie de l'archive frontend
                        scp -o StrictHostKeyChecking=no \\
                            "dist/${ARTIFACT_PREFIX}-frontend.zip" \\
                            ${DEPLOY_USER}@${DEPLOY_SERVER}:/tmp/
                        
                        # Déploiement sur le serveur
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_SERVER} << 'DEPLOY_EOF'
                            echo "🗂️ Sauvegarde de l'ancien frontend"
                            sudo mkdir -p /var/backups/frontend
                            sudo cp -r /var/www/html /var/backups/frontend/backup-$(date +%Y%m%d-%H%M%S) 2>/dev/null || true
                            
                            echo "🧹 Nettoyage du répertoire web"
                            sudo rm -rf /var/www/html/*
                            
                            echo "📦 Extraction du nouveau frontend"
                            cd /tmp
                            unzip -o ${ARTIFACT_PREFIX}-frontend.zip
                            sudo cp -r frontend/* /var/www/html/
                            sudo chown -R www-data:www-data /var/www/html
                            sudo chmod -R 644 /var/www/html
                            sudo find /var/www/html -type d -exec chmod 755 {} \\;
                            
                            echo "🔄 Redémarrage Apache"
                            sudo systemctl reload apache2
                            
                            echo "✅ Frontend déployé"
                            ls -la /var/www/html/
DEPLOY_EOF
                        
                        echo "✅ Frontend déployé avec succès"
                    '''
                }
            }
        }
        
        stage('⚙️ Deploy Backend') {
            when {
                expression { currentBuild.result != 'FAILURE' }
            }
            steps {
                echo '🐍 Déploiement Backend Python'
                sshagent(['deploy-ssh-key']) {
                    sh '''
                        echo "📤 Envoi backend vers serveur"
                        
                        # Copie de l'archive backend
                        scp -o StrictHostKeyChecking=no \\
                            "dist/${ARTIFACT_PREFIX}-backend.zip" \\
                            ${DEPLOY_USER}@${DEPLOY_SERVER}:/tmp/
                        
                        # Déploiement sur le serveur
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_SERVER} << 'BACKEND_EOF'
                            echo "🗂️ Sauvegarde de l'ancien backend"
                            sudo mkdir -p /var/backups/backend
                            sudo cp -r /opt/backend-app /var/backups/backend/backup-$(date +%Y%m%d-%H%M%S) 2>/dev/null || true
                            
                            echo "🛑 Arrêt du service backend"
                            sudo systemctl stop backend-app 2>/dev/null || echo "Service pas encore installé"
                            
                            echo "🧹 Nettoyage du répertoire backend"
                            sudo rm -rf /opt/backend-app/*
                            
                            echo "📦 Extraction du nouveau backend"
                            cd /tmp
                            unzip -o ${ARTIFACT_PREFIX}-backend.zip
                            sudo cp -r backend/* /opt/backend-app/
                            sudo chown -R deploy:deploy /opt/backend-app
                            sudo chmod +x /opt/backend-app/app_deploy.py
                            
                            echo "🔧 Installation des dépendances Python"
                            cd /opt/backend-app
                            if [ -f "requirements.txt" ]; then
                                sudo apt-get update && sudo apt-get install -y python3-pip
                                pip3 install -r requirements.txt
                            else
                                sudo apt-get update && sudo apt-get install -y python3-pip
                                pip3 install flask flask-cors requests
                            fi
                            
                            echo "⚙️ Configuration du service systemd"
                            sudo cp backend-app.service /etc/systemd/system/
                            sudo systemctl daemon-reload
                            sudo systemctl enable backend-app
                            
                            echo "🚀 Démarrage du service backend"
                            sudo systemctl start backend-app
                            sleep 3
                            sudo systemctl status backend-app
                            
                            echo "✅ Backend déployé et démarré"
BACKEND_EOF
                        
                        echo "✅ Backend déployé avec succès"
                    '''
                }
            }
        }
        
        stage('🧪 Post-Deploy Tests') {
            steps {
                echo '🔍 Tests post-déploiement'
                sshagent(['deploy-ssh-key']) {
                    sh '''
                        echo "🌐 Test du frontend"
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_SERVER} \\
                            "curl -s -o /dev/null -w '%{http_code}' http://localhost/" || echo "Frontend test échoué"
                        
                        echo "🐍 Test du backend"
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_SERVER} \\
                            "curl -s -o /dev/null -w '%{http_code}' http://localhost:5000/ || echo 'Backend en cours de démarrage...'"
                        
                        sleep 5
                        
                        echo "📊 Statut des services"
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_SERVER} \\
                            "sudo systemctl is-active apache2 && sudo systemctl is-active backend-app"
                    '''
                }
            }
        }
        
        stage('📊 Deployment Summary') {
            steps {
                sh '''
                    echo "🎯 RÉSUMÉ DU DÉPLOIEMENT"
                    echo "======================"
                    echo "📦 Version: ${BUILD_VERSION}"
                    echo "📅 Date: $(date)"
                    echo "🌐 Serveur: ${DEPLOY_SERVER}"
                    echo "👤 Utilisateur: ${DEPLOY_USER}"
                    echo ""
                    echo "✅ Frontend déployé: http://${DEPLOY_SERVER}/"
                    echo "✅ Backend déployé: http://${DEPLOY_SERVER}:5000/"
                    echo "📊 Logs: sudo journalctl -u backend-app -f"
                    
                    cat > deployment-info.json << 'DEPEOF'
{
    "deployment_version": "${BUILD_VERSION}",
    "deployment_date": "$(date -Iseconds)",
    "server": "${DEPLOY_SERVER}",
    "frontend_url": "http://${DEPLOY_SERVER}/",
    "backend_url": "http://${DEPLOY_SERVER}:5000/",
    "services": ["apache2", "backend-app"]
}
DEPEOF
                '''
            }
        }
    }
    
    post {
        always {
            script {
                try {
                    if (fileExists('dist/')) {
                        archiveArtifacts artifacts: 'dist/*.zip, deployment-info.json', 
                                       fingerprint: true, 
                                       allowEmptyArchive: false
                        echo "✅ Artefacts archivés"
                    }
                } catch (Exception e) {
                    echo "⚠️ Archivage partiel: ${e.getMessage()}"
                }
            }
        }
        
        success {
            echo '🎉 DÉPLOIEMENT CONTINU RÉUSSI!'
            echo "✅ Application disponible sur http://${env.DEPLOY_SERVER}/"
        }
        
        failure {
            echo '❌ DÉPLOIEMENT ÉCHOUÉ!'
            echo '🔄 Rollback automatique recommandé'
        }
        
        unstable {
            echo '⚠️ DÉPLOIEMENT INSTABLE!'
        }
    }
}
